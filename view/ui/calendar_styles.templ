package ui

templ CalendarStyles() {
	<style>
		.calendar-month-grid {
			table-layout: fixed;
			border-collapse: collapse;
			width: 100%;
		}
		.calendar-month-grid th {
			padding: 0.5rem;
			text-align: center;
			font-size: 0.75rem;
			font-weight: 500;
			color: #6b7280;
			border-bottom: 1px solid #e5e7eb;
		}
		.calendar-day-cell {
			min-height: 5rem;
			padding: 0.25rem;
			border: 1px solid #e5e7eb;
			cursor: pointer;
			vertical-align: top;
			transition: background-color 0.15s;
		}
		.calendar-day-cell:hover {
			background-color: #f9fafb;
		}
		.calendar-day-cell.active {
			background-color: #eff6ff;
		}
		.calendar-day-cell.other-month {
			opacity: 0.4;
		}
		.calendar-day-cell.today {
			background-color: #f0f9ff;
		}
		.calendar-day-cell.today .calendar-day-number {
			background-color: #2563eb;
			color: white;
			border-radius: 50%;
			width: 1.5rem;
			height: 1.5rem;
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}
		.calendar-event-badge {
			display: flex;
			align-items: center;
			gap: 0.25rem;
			padding: 0.125rem 0.375rem;
			margin: 0.125rem 0;
			border-radius: 0.25rem;
			font-size: 0.625rem;
			line-height: 1rem;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			border-width: 1px;
			cursor: pointer;
		}
		.calendar-event-card {
			position: absolute;
			left: 2px;
			right: 2px;
			border-radius: 0.25rem;
			padding: 0.25rem 0.375rem;
			font-size: 0.75rem;
			line-height: 1rem;
			overflow: hidden;
			border-width: 1px;
			cursor: pointer;
			z-index: 1;
		}
		.calendar-time-slot {
			height: 3rem;
			border-bottom: 1px solid #f3f4f6;
			position: relative;
		}
		.calendar-time-slot:nth-child(even) {
			border-bottom-style: dashed;
		}
		.calendar-time-label {
			position: absolute;
			top: -0.5rem;
			left: 0;
			font-size: 0.625rem;
			color: #9ca3af;
			transform: translateY(-50%);
		}
		.calendar-current-time {
			position: absolute;
			left: 0;
			right: 0;
			height: 2px;
			background-color: #ef4444;
			z-index: 10;
		}
		.calendar-current-time::before {
			content: '';
			position: absolute;
			left: -4px;
			top: -3px;
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background-color: #ef4444;
		}
		.calendar-header-btn {
			padding: 0.375rem 0.75rem;
			font-size: 0.875rem;
			font-weight: 500;
			border-radius: 0.375rem;
			transition: background-color 0.15s;
		}
		.calendar-day-events {
			min-height: 3rem;
			padding: 0.5rem;
			border-top: 1px solid #e5e7eb;
		}
		.calendar-scrollable::-webkit-scrollbar {
			width: 6px;
			height: 6px;
		}
		.calendar-scrollable::-webkit-scrollbar-track {
			background: transparent;
		}
		.calendar-scrollable::-webkit-scrollbar-thumb {
			background-color: rgba(156, 163, 175, 0.5);
			border-radius: 3px;
		}
		.calendar-scrollable::-webkit-scrollbar-thumb:hover {
			background-color: rgba(156, 163, 175, 0.7);
		}
		.calendar-timeline-sentinel {
			height: 1px;
			width: 100%;
		}
		.calendar-timeline-loading {
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 1rem;
			color: #6b7280;
			font-size: 0.875rem;
		}
	</style>
}
