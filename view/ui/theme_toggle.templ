package ui

import "github.com/fbv/go-templ-ui/view/i18n"

// ThemeToggle is a reusable light/dark switch. It flips data-theme and the
// dark class on <html> together and persists the choice to localStorage.
templ ThemeToggle() {
	<button
		type="button"
		onclick="toggleTheme()"
		title={ i18n.T(ctx, i18n.KeyToggleTheme) }
		aria-label={ i18n.T(ctx, i18n.KeyToggleTheme) }
		class="inline-flex items-center gap-1.5 rounded-[var(--rounded-md)] border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-1.5 text-[length:var(--text-label-size)] font-[number:var(--text-label-weight)] text-[var(--color-ink-muted)] hover:bg-[var(--color-highlight)] hover:text-[var(--color-ink)]"
	>
		<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"></path>
		</svg>
		<span>{ i18n.T(ctx, i18n.KeyTheme) }</span>
	</button>
}

templ ThemeToggleScript() {
	<script>
		if (!window._themeToggleInitialized) {
			window._themeToggleInitialized = true;
			window.toggleTheme = function () {
				var root = document.documentElement;
				var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
				root.setAttribute("data-theme", next);
				if (next === "dark") {
					root.classList.add("dark");
				} else {
					root.classList.remove("dark");
				}
				try { localStorage.setItem("theme", next); } catch (e) {}
			};
		}
	</script>
}
