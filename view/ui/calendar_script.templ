package ui

templ CalendarScript() {
	<script>
		if (!window._calendarInitialized) {
			window._calendarInitialized = true;
			window.calendarFormatTime = function(dateStr) {
				var d = new Date(dateStr);
				return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
			};
			window.calendarFormatDate = function(dateStr) {
				var d = new Date(dateStr);
				return String(d.getDate()).padStart(2, '0') + '.' + String(d.getMonth() + 1).padStart(2, '0') + '.' + d.getFullYear();
			};
			window.calendarIsSameDay = function(a, b) {
				var da = new Date(a);
				var db = new Date(b);
				return da.getFullYear() === db.getFullYear() && da.getMonth() === db.getMonth() && da.getDate() === db.getDate();
			};
			window.calendarGetColorClasses = function(color) {
				var map = {
					blue:   { bg: 'bg-blue-100', text: 'text-blue-800', border: 'border-blue-300', dot: 'bg-blue-500', darkBg: 'dark:bg-blue-900', darkText: 'dark:text-blue-300', darkBorder: 'dark:border-blue-700' },
					red:    { bg: 'bg-red-100', text: 'text-red-800', border: 'border-red-300', dot: 'bg-red-500', darkBg: 'dark:bg-red-900', darkText: 'dark:text-red-300', darkBorder: 'dark:border-red-700' },
					green:  { bg: 'bg-green-100', text: 'text-green-800', border: 'border-green-300', dot: 'bg-green-500', darkBg: 'dark:bg-green-900', darkText: 'dark:text-green-300', darkBorder: 'dark:border-green-700' },
					yellow: { bg: 'bg-yellow-100', text: 'text-yellow-800', border: 'border-yellow-300', dot: 'bg-yellow-500', darkBg: 'dark:bg-yellow-900', darkText: 'dark:text-yellow-300', darkBorder: 'dark:border-yellow-700' },
					purple: { bg: 'bg-purple-100', text: 'text-purple-800', border: 'border-purple-300', dot: 'bg-purple-500', darkBg: 'dark:bg-purple-900', darkText: 'dark:text-purple-300', darkBorder: 'dark:border-purple-700' },
					gray:   { bg: 'bg-gray-100', text: 'text-gray-800', border: 'border-gray-300', dot: 'bg-gray-400', darkBg: 'dark:bg-gray-700', darkText: 'dark:text-gray-300', darkBorder: 'dark:border-gray-600' }
				};
				return map[color] || map.blue;
			};
		}
	</script>
}
