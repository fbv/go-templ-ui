package ui

templ nop(){
}

templ MasterDetails(master templ.Component, details templ.Component) {
    <div class="grid grid-cols-3">
        <div class="m-4">
            @master
        </div>
        <div class="col-span-2 my-4 me-4">
            @details
        </div>
    </div>
}

// Card is a passive container: DESIGN.md defines it by tone and border alone
// (surface + border, rounded-lg) with no shadow, never a coloured fill.
templ Card() {
    <div class="p-8 mb-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]">
        { children... }
    </div>
}
