package showcase

import (
	"github.com/fbv/go-templ-ui/view/layout"
	"github.com/fbv/go-templ-ui/view/ui"
)

// DemoProp is one row of the props summary table on a demo page.
type DemoProp struct {
	Name        string
	Type        string
	Required    string
	Description string
}

// DemoVariant is one cell of the variant/state matrix: a live preview plus the
// code snippet that produces it.
type DemoVariant struct {
	Title   string
	Preview templ.Component
	Code    string
}

// DemoPageProps configures the shared demo-page scaffold.
//
// Title and DocsPath come from the component's registry row
// (showcase/registry.go), not from literals in the demo file, so a demo can
// never diverge from its own sidebar link and docs URL.
type DemoPageProps struct {
	Name        string
	Title       string
	Description string
	Props       []DemoProp
	Variants    []DemoVariant
	DocsPath    string
}

// DemoPage is the showcase demo-page convention: title, props summary,
// variant/state matrix with live preview and ui.Code snippet, and a link to
// docs/<name>.md. Every later component demo is built on this scaffold.
//
// Headings come from ui.H1/H2/H3 (token-based roles), not local copies, so the
// scaffold cannot drift from the components it demonstrates.
templ DemoPage(p *DemoPageProps) {
	@layout.Page(&layout.PageProps{Title: p.Title + " - Showcase"}) {
		<div class="flex flex-row">
			@Sidebar()
			<div id={ "demo-" + p.Name } class="flex-1 w-auto h-screen overflow-y-auto p-4">
				<div class="flex items-start justify-between gap-4">
					<div class="[&>h1]:mt-0">@ui.H1(p.Title)</div>
					@ui.ThemeToggle()
				</div>
				if p.Description != "" {
					<p class="text-[length:var(--text-body-size)] text-[var(--color-ink-muted)] mb-4">{ p.Description }</p>
				}
				if len(p.Props) > 0 {
					@ui.H2("Props")
					<table class="border-collapse table-auto w-full mb-4">
						<thead>
							<tr>
								<th class="border-b border-[var(--color-border)] px-2 py-1 text-left text-[length:var(--text-overline-size)] font-[number:var(--text-overline-weight)] leading-[var(--text-overline-leading)] uppercase tracking-[var(--text-overline-tracking)] text-[var(--color-ink-subtle)]">Property</th>
								<th class="border-b border-[var(--color-border)] px-2 py-1 text-left text-[length:var(--text-overline-size)] font-[number:var(--text-overline-weight)] leading-[var(--text-overline-leading)] uppercase tracking-[var(--text-overline-tracking)] text-[var(--color-ink-subtle)]">Type</th>
								<th class="border-b border-[var(--color-border)] px-2 py-1 text-left text-[length:var(--text-overline-size)] font-[number:var(--text-overline-weight)] leading-[var(--text-overline-leading)] uppercase tracking-[var(--text-overline-tracking)] text-[var(--color-ink-subtle)]">Required</th>
								<th class="border-b border-[var(--color-border)] px-2 py-1 text-left text-[length:var(--text-overline-size)] font-[number:var(--text-overline-weight)] leading-[var(--text-overline-leading)] uppercase tracking-[var(--text-overline-tracking)] text-[var(--color-ink-subtle)]">Description</th>
							</tr>
						</thead>
						<tbody>
							for _, prop := range p.Props {
								<tr class="border-b border-[var(--color-border)]">
									<td class="px-2 py-1 font-[number:var(--text-mono-weight)] text-[length:var(--text-mono-size)] text-[var(--color-ink)]">{ prop.Name }</td>
									<td class="px-2 py-1 text-[length:var(--text-body-sm-size)] text-[var(--color-ink-muted)]">{ prop.Type }</td>
									<td class="px-2 py-1 text-[length:var(--text-body-sm-size)] text-[var(--color-ink-muted)]">{ prop.Required }</td>
									<td class="px-2 py-1 text-[length:var(--text-body-sm-size)] text-[var(--color-ink)]">{ prop.Description }</td>
								</tr>
							}
						</tbody>
					</table>
				}
				if len(p.Variants) > 0 {
					@ui.H2("Variants & states")
					for _, v := range p.Variants {
						@ui.H3(v.Title)
						<div class="rounded-[var(--rounded-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-4 mb-2">
							@v.Preview
						</div>
						<div class="mb-4">
							@ui.Code(&ui.CodeProps{Language: "go", Content: v.Code})
						</div>
					}
				}
				@ui.H2("Docs")
				<p class="text-[length:var(--text-body-size)] text-[var(--color-ink-muted)]">
					Full API reference: <a class="text-[var(--color-action)] underline" href={ templ.URL(p.DocsPath) }>{ p.DocsPath }</a>
				</p>
			</div>
		</div>
	}
}
