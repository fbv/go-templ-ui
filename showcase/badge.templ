package showcase

import "github.com/fbv/go-templ-ui/view/ui"

// BadgeDemoPage is the convention proof: Badge demo built on DemoPage and
// registered at /showcase/badge. Its title and docs path come from the registry
// row (showcase/registry.go) — never from literals here — so the page and its
// sidebar/docs links cannot diverge.
templ BadgeDemoPage(d Demo) {
	@DemoPage(&DemoPageProps{
		Name:        d.Name,
		Title:       d.Title,
		DocsPath:    d.DocsPath,
		Description: "Status pill for labels and state. Styled entirely with semantic/component tokens — light and dark recolor by swapping token values alone.",
		Props: []DemoProp{
			{Name: "Name", Type: "string", Required: "Yes", Description: "Badge label text"},
			{Name: "Style", Type: "string", Required: "No", Description: `Visual variant: "red", "green", "yellow", "ping", "gray", "indigo", "purple", "blue". There is no "gray" case: "gray", "indigo", "purple" and "blue" take the same neutral default variant as an empty or unknown Style.`},
		},
		Variants: []DemoVariant{
			{
				Title:   "Neutral (gray / indigo / purple / blue / default)",
				Preview: badgeDemoRow(),
				Code:    "@ui.Badge(&ui.BadgeProps{Name: \"Draft\", Style: \"gray\"})\n@ui.Badge(&ui.BadgeProps{Name: \"Archived\", Style: \"indigo\"})\n@ui.Badge(&ui.BadgeProps{Name: \"Label\", Style: \"purple\"})\n@ui.Badge(&ui.BadgeProps{Name: \"New: 2\", Style: \"blue\"})\n@ui.Badge(&ui.BadgeProps{Name: \"Default\"})",
			},
			{
				Title:   "Success (green)",
				Preview: ui.Badge(&ui.BadgeProps{Name: "Active", Style: "green"}),
				Code:    "@ui.Badge(&ui.BadgeProps{Name: \"Active\", Style: \"green\"})",
			},
			{
				Title:   "Warning (yellow) — tinted-neutral pill; the warning border carries the status cue",
				Preview: ui.Badge(&ui.BadgeProps{Name: "Pending", Style: "yellow"}),
				Code:    "@ui.Badge(&ui.BadgeProps{Name: \"Pending\", Style: \"yellow\"})",
			},
			{
				Title:   "Danger (red / ping)",
				Preview: badgeDemoDangerRow(),
				Code:    "@ui.Badge(&ui.BadgeProps{Name: \"Overdue\", Style: \"red\"})\n@ui.Badge(&ui.BadgeProps{Name: \"Escalated\", Style: \"ping\"})",
			},
			{
				Title:   "Fallback (empty / unknown Style)",
				Preview: badgeDemoFallbackRow(),
				Code:    "@ui.Badge(&ui.BadgeProps{Name: \"Empty\", Style: \"\"})\n@ui.Badge(&ui.BadgeProps{Name: \"Unknown\", Style: \"not-a-style\"})",
			},
		},
	})
}

templ badgeDemoRow() {
	@ui.Badge(&ui.BadgeProps{Name: "Draft", Style: "gray"})
	@ui.Badge(&ui.BadgeProps{Name: "Archived", Style: "indigo"})
	@ui.Badge(&ui.BadgeProps{Name: "Label", Style: "purple"})
	@ui.Badge(&ui.BadgeProps{Name: "New: 2", Style: "blue"})
	@ui.Badge(&ui.BadgeProps{Name: "Default"})
}

templ badgeDemoDangerRow() {
	@ui.Badge(&ui.BadgeProps{Name: "Overdue", Style: "red"})
	@ui.Badge(&ui.BadgeProps{Name: "Escalated", Style: "ping"})
}

templ badgeDemoFallbackRow() {
	@ui.Badge(&ui.BadgeProps{Name: "Empty", Style: ""})
	@ui.Badge(&ui.BadgeProps{Name: "Unknown", Style: "not-a-style"})
}
