package showcase

import (
	"github.com/fbv/go-templ-ui/view/ui"
	"github.com/fbv/go-templ-ui/view/layout"
)

templ TreePage() {
	@layout.Page(&layout.PageProps{Title: "Tree Component Showcase"}) {
		@ui.SidebarStyles()
		@ui.SidebarScript()
		<div class="flex flex-row">
			@Sidebar()
			<div class="flex-1 w-auto h-screen overflow-y-auto p-4">
				<div class="max-w-4xl mx-auto p-6 space-y-12">
					@ui.H1("Tree Component")
					@ui.H2("Default Tree")
					<p class="text-sm text-gray-500 mb-4">Basic tree with expandable nodes and icons.</p>
					@ui.Tree(&ui.TreeProps{
						ID:        "tree-default",
						Nodes:     GetDefaultTreeNodes(),
						ShowIcons: true,
					})
					@ui.H2("Single Selection")
					<p class="text-sm text-gray-500 mb-4">Click nodes to select them. Only one node can be selected at a time.</p>
					@ui.Tree(&ui.TreeProps{
						ID:        "tree-single",
						Nodes:     GetDefaultTreeNodes(),
						Selection: ui.TreeSelectionSingle,
						ShowIcons: true,
					})
					@ui.H2("Multi Selection")
					<p class="text-sm text-gray-500 mb-4">Hold Ctrl/Cmd to select multiple nodes.</p>
					@ui.Tree(&ui.TreeProps{
						ID:        "tree-multi",
						Nodes:     GetDefaultTreeNodes(),
						Selection: ui.TreeSelectionMulti,
						ShowIcons: true,
					})
					@ui.H2("Bordered Style")
					<p class="text-sm text-gray-500 mb-4">Tree with bordered container and node separators.</p>
					@ui.Tree(&ui.TreeProps{
						ID:        "tree-bordered",
						Nodes:     GetDefaultTreeNodes(),
						Style:     ui.TreeStyleBordered,
						ShowIcons: true,
					})
					@ui.H2("Compact Style")
					<p class="text-sm text-gray-500 mb-4">Smaller font and tighter spacing.</p>
					@ui.Tree(&ui.TreeProps{
						ID:        "tree-compact",
						Nodes:     GetDefaultTreeNodes(),
						Style:     ui.TreeStyleCompact,
						ShowIcons: true,
					})
					@ui.H2("With Badges")
					<p class="text-sm text-gray-500 mb-4">Nodes with badge indicators.</p>
					@ui.Tree(&ui.TreeProps{
						ID:        "tree-badges",
						Nodes:     GetTreeWithBadges(),
						ShowIcons: true,
						Selection: ui.TreeSelectionSingle,
					})
					@ui.H2("Lazy Loading (HTMX)")
					<p class="text-sm text-gray-500 mb-4">Children are loaded on demand when nodes are expanded.</p>
					@ui.Tree(&ui.TreeProps{
						ID:          "tree-lazy",
						Nodes:       GetLazyTreeNodes(),
						LazyLoad:    true,
						LazyLoadURL: "/showcase/tree/children",
						ShowIcons:   true,
					})
					@ui.H2("Scrollable")
					<p class="text-sm text-gray-500 mb-4">Deep tree in a scrollable container.</p>
					@ui.Tree(&ui.TreeProps{
						ID:              "tree-scroll",
						Nodes:           GetDeepTreeNodes(),
						ShowIcons:       true,
						Scrollable:      true,
						ScrollMaxHeight: "h-64",
					})
				</div>
			</div>
		</div>
	}
}
